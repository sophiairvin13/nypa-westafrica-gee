/**********************
 * X.x Probability maps - all classes (appendix)
 **********************/

// Class indices: 0=Nypa, 1=Mangrove, 2=Infrastructure, 3=Water
var classNames  = ['Nypa', 'Mangrove and Other Forest', 'Infrastructure', 'Water'];
var classIndex  = [0, 1, 2, 3];
var classPalettes = [
  ['white', '#EE3377'],  // Nypa - pink
  ['white', '#228833'],  // Mangrove - green
  ['white', '#BBBBBB'],  // Infrastructure - grey
  ['white', '#4477AA']   // Water - blue
];

var classifiers = [
  {classifier: probClassifier_parrot, image: embeddingsImage,  region: testsite, name: 'Parrot_Island'},
  {classifier: probClassifier_direct, image: apoiEmbeddings,   region: apoi,     name: 'Apoi_Direct'},
  {classifier: probClassifier_apoi,   image: apoiEmbeddings,   region: apoi,     name: 'Apoi_Local'}
];

classifiers.forEach(function(model) {
  var probImage = model.image.classify(model.classifier);
  
  classIndex.forEach(function(idx) {
    var classProb = probImage.arrayGet(idx);
    var className = classNames[idx];
    
    Map.addLayer(
      classProb,
      {min: 0, max: 1, palette: classPalettes[idx]},
      'Prob - ' + model.name + ' - ' + className
    );
    
    Export.image.toDrive({
      image:       classProb.clip(model.region),
      description: 'prob_' + model.name + '_' + className,
      scale:       10,
      region:      model.region.geometry(),
      maxPixels:   1e13
    });
  });
});
