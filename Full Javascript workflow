/**********************
 * X.x Area statistics - proportion of mangrove that is Nypa
 **********************/

function calcClassAreas(combinedImg, region, label) {
  
  // Mangrove only (value = 1)
  var mangrove_only = combinedImg.eq(1);
  // Nypa only (value = 2)
  var nypa_only = combinedImg.eq(2);
  // Overlap/intersection (value = 3)
  var overlap = combinedImg.eq(3);

  var areaImage = ee.Image.pixelArea().divide(10000); // convert m² to hectares

  // Calculate areas
  var mangrove_area = areaImage.updateMask(mangrove_only).reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: region,
    scale: 30,
    maxPixels: 1e13
  });

  var nypa_area = areaImage.updateMask(nypa_only).reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: region,
    scale: 30,
    maxPixels: 1e13
  });

  var overlap_area = areaImage.updateMask(overlap).reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: region,
    scale: 30,
    maxPixels: 1e13
  });

  // Total mangrove footprint = mangrove only + overlap
  var total_mangrove = ee.Number(mangrove_area.get('area'))
    .add(ee.Number(overlap_area.get('area')));

  // Nypa within mangrove = overlap area (pixels that are BOTH)
  var nypa_in_mangrove = ee.Number(overlap_area.get('area'));

  // Proportion of mangrove area that is also Nypa
  var proportion = nypa_in_mangrove.divide(total_mangrove).multiply(100);

  print('--- ' + label + ' ---');
  print('Mangrove only area (ha):', mangrove_area.get('area'));
  print('Nypa only area (ha):', nypa_area.get('area'));
  print('Overlap area / Nypa within Mangrove (ha):', overlap_area.get('area'));
  print('Total mangrove footprint (ha):', total_mangrove);
  print('% of mangrove area that is Nypa:', proportion);
}


