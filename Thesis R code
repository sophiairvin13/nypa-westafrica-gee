CONFUSION MATRICES

library(caret)
library(ggplot2)
library(dplyr)
library(patchwork)

class_labels  <- c("Nypa", "Mangrove", "Infrastructure", "Water")
class_levels  <- c(0, 1, 2, 3)
gradient_high <- "#444444"
create_matrix <- function(file_path, plot_title, show_legend = FALSE,
                          show_y_axis = FALSE, show_x_label = FALSE) {
  
  data <- read.csv(file_path) %>%
    select(class, classification) %>%
    mutate(
      class          = factor(class,          levels = class_levels, labels = class_labels),
      classification = factor(classification, levels = class_levels, labels = class_labels)
    )
  cm <- confusionMatrix(data$classification, data$class)
  oa_label <- sprintf("Overall Accuracy = %.1f%%", cm$overall["Accuracy"] * 100)
  plt_norm <- as.data.frame(cm$table) %>%
    group_by(Reference) %>%
    mutate(Proportion = Freq / sum(Freq)) %>%
    ungroup()
  ggplot(plt_norm, aes(x = Reference, y = Prediction, fill = Proportion)) +
    geom_tile(colour = "white", linewidth = 0.8) +
    geom_text(aes(label = round(Proportion, 2)),
              size     = 5.5,
              colour   = ifelse(plt_norm$Proportion > 0.5, "white", "grey20"),
              fontface = "bold") +
    scale_fill_gradient(
      low    = "white",
      high   = gradient_high,
      limits = c(0, 1),
      name   = "Proportion\nof actual class",
      guide  = guide_colorbar(
        barheight = unit(12, "cm"),  # stretch legend to match panel height
        barwidth  = unit(0.6, "cm")
      )
    ) +
    labs(
      title    = plot_title,
      subtitle = oa_label,
      x        = if (show_x_label) "Actual (Ground Truth)" else NULL,
      y        = if (show_y_axis)  "Predicted Class" else NULL
    ) +
    theme_minimal() +
    theme(
      axis.text.x     = element_text(angle = 45, hjust = 1, colour = "black", size = 14),
      axis.text.y     = if (show_y_axis) {
                          element_text(angle = 45, hjust = 1, colour = "black", size = 14)
                        } else {
                          element_blank()
                        },
      axis.title.x    = if (show_x_label) element_text(size = 15, face = "bold") else element_blank(),
      axis.title.y    = if (show_y_axis)  element_text(size = 15, face = "bold") else element_blank(),
      axis.ticks.y    = if (show_y_axis)  element_line() else element_blank(),
      panel.grid      = element_blank(),
      aspect.ratio    = 1,
      plot.title      = element_text(face = "bold", hjust = 0.5, size = 15),
      plot.subtitle   = element_text(hjust = 0.5, colour = "grey40", size = 13),
      legend.position = if (show_legend) "right" else "none",
      legend.title    = element_text(size = 13),
      legend.text     = element_text(size = 12),
      plot.margin     = margin(5, 0, 5, 0)
    ) +
    coord_fixed()
}
p1 <- create_matrix(
  file.choose(),  # testsite_validation_Results.csv
  "Parrot Island: Local Model",
  show_legend  = FALSE,
  show_y_axis  = TRUE,
  show_x_label = FALSE
)
p2 <- create_matrix(
  file.choose(),  # apoi_validation_results.csv
  "Apoi: Direct Transfer",
  show_legend  = FALSE,
  show_y_axis  = FALSE,
  show_x_label = TRUE
)
p3 <- create_matrix(
  file.choose(),  # apoi_trained_predictions.csv
  "Apoi: Local Model",
  show_legend  = TRUE,
  show_y_axis  = FALSE,
  show_x_label = FALSE
)
combined <- (p1 | p2 | p3) +
  plot_layout(guides = "collect")
combined
ggsave("confusion_matrices_combined.png",
       plot   = combined,
       width  = 18,
       height = 7,
       dpi    = 300,
       bg     = "white")
message("Saved: confusion_matrices_combined.png")

