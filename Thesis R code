pal_mang  <- c("white", "#228833")
pal_infra <- c("white", "#555555")
pal_water <- c("white", "#4477AA")
plot_prob <- function(file_path, palette,
                      legend_title = "Probability",
                      show_legend = FALSE) {
  r <- rast(file_path)
 
  ggplot() +
    geom_spatraster(data = r) +
    scale_fill_gradient(
      low      = palette[1],
      high     = palette[2],
      limits   = c(0, 1),
      name     = legend_title,
      na.value = "transparent"
    ) +
    theme_void() +
    theme(
      legend.position   = if (show_legend) "bottom" else "none",
      legend.key.width  = unit(1.5, "cm"),
      legend.key.height = unit(0.4, "cm"),
      legend.title      = element_text(size = 12, face = "bold"),
      legend.text       = element_text(size = 11),
      plot.margin       = margin(1, 3, 1, 3)
    )
}
make_header <- function(text) {
  ggplot() +
    annotate("text", x = 0.5, y = 0.5, label = text,
             fontface = "bold", size = 6, hjust = 0.5) +
    theme_void()
}
make_row_label <- function(text) {
  ggplot() +
    annotate("text", x = 0.5, y = 0.5, label = text,
             fontface = "bold", size = 5, angle = 90, hjust = 0.5) +
    theme_void()
}

